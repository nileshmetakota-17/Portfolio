# Copy to .env.local. Keep real credentials out of this template.
# Gmail mode sends to visitors without purchasing or verifying a custom domain.
RESUME_EMAIL_PROVIDER=gmail
GMAIL_USER=nilesh.metakota@gmail.com
# Google App Password, NOT your regular Gmail password. Requires 2-Step Verification.
GMAIL_APP_PASSWORD=
RESUME_OWNER_EMAIL=nilesh.metakota@gmail.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional previous Resend mode (RESUME_EMAIL_PROVIDER=resend).
RESEND_API_KEY=
RESUME_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
